# Copy to .env and fill in values

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# ── OpenRouter (alternative — free/cheap models) ─────────────────────────────
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini          # cheapest good option
# OPENAI_MODEL=google/gemini-flash-1.5     # very cheap
# OPENAI_MODEL=anthropic/claude-haiku      # good quality
# OPENAI_MODEL=mistralai/mistral-7b-instruct  # free tier

# ── Agent tuning (optional) ──────────────────────────────────────────────────
HIVER_AUTO_THRESHOLD=0.62
HIVER_RETRIEVAL_K=5
HIVER_MAX_RETRIEVAL_CORPUS=15000
HIVER_BRAND=AppleSupport
HIVER_SEED=42
