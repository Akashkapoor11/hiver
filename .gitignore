# Python artefacts
.venv/
__pycache__/
*.pyc
*.pyo
.env
.DS_Store

# Labeler tool state (local only — not submission evidence)
data/golden/.labeler_state.json

# Raw data — too large to commit (download from Kaggle)
data/raw/
archive.zip
*.zip

# Processed data — regenerated by `make reproduce` (too large to commit)
data/processed/*.csv
data/processed/*.joblib
data/processed/*.json

# Golden set — COMMITTED (these are the hand-labelled evaluation artefacts)
# data/golden/ — DO NOT ignore, these must be in the repo

# Results — COMMITTED (reviewers need to see the proof without running the pipeline)
# results/   — DO NOT ignore

# IDE / OS
.idea/
.vscode/
*.egg-info/
dist/
build/
